# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# ── Browser (public, bundled into the site) ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Server only. Never prefix these with NEXT_PUBLIC_ ───────────────────
# Firebase service account (Firebase console → Project settings → Service accounts →
# Generate new private key). Paste the JSON base64-encoded:  base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# AI provider keys used by /api/ai, comma-separated. gsk_… = Groq, xai-… = xAI.
AI_API_KEYS=

# Optional fallback keys, tried only after every AI_API_KEYS key failed. AIza… / AQ.… = Gemini.
AI_FALLBACK_API_KEYS=

# Emails allowed to use /admin and grant credits, comma-separated.
ADMIN_EMAILS=
